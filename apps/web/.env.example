# Auth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth (settings/developers → New OAuth App)
# Local dev callback: http://localhost:3001/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Anthropic key passed to spawned goose-runner containers
ANTHROPIC_API_KEY=

# Where the gateway is reachable from goose-runner machines.
# Local: docker network DNS, "gateway:3000". On Fly: "gateway.internal:3000".
GATEWAY_URL=http://gateway:3000

# Local: spawn goose-runner via docker. On Fly: spawn via Machines API (M5).
LOCAL_GOOSE=1

# When LOCAL_GOOSE=1: docker network to attach goose-runner containers to,
# so they can resolve `gateway` by name (matches networks.default.name in compose).
GOOSE_DOCKER_NETWORK=gloop

# When LOCAL_GOOSE=1: image to spawn (built by docker compose build goose-runner).
GOOSE_DOCKER_IMAGE=serverless-flying-geese-and-gateway-goose-runner

# Where session-mapping SQLite lives.
SESSIONS_DB_PATH=./data/sessions.db

# How many minutes of WS idleness before destroying a goose machine.
GOOSE_IDLE_MINUTES=5
