# Merged gateway config: routes MCP for both research and ecommerce backends
# behind a single bind on :3000.
#
# Hostnames are env-substituted by entrypoint.sh so this same template works
# in docker-compose (service-name DNS) and on Fly (*.internal DNS).

registry:
  # Bind-mounted from the web app's data/ — edits via the /registry UI land
  # here and the gateway picks them up within refreshInterval.
  source: file:///var/registry/registry.json
  refreshInterval: 10s

binds:
  - port: 3000
    listeners:
      - routes:
          - backends:
              - mcp:
                  targets:
                    # ----- research bundle -----
                    - name: search-service
                      mcp:
                        host: http://${RESEARCH_MCP_HOST}:8001/mcp
                    - name: fetch-service
                      mcp:
                        host: http://${RESEARCH_MCP_HOST}:8002/mcp
                    - name: entity-service
                      mcp:
                        host: http://${RESEARCH_MCP_HOST}:8003/mcp
                    - name: category-service
                      mcp:
                        host: http://${RESEARCH_MCP_HOST}:8004/mcp
                    - name: tag-service
                      mcp:
                        host: http://${RESEARCH_MCP_HOST}:8005/mcp

                    # ----- ecommerce bundle -----
                    - name: catalog-service
                      mcp:
                        host: http://${ECOMMERCE_MCP_HOST}:8001/mcp
                    - name: cart-service
                      mcp:
                        host: http://${ECOMMERCE_MCP_HOST}:8002/mcp
                    - name: order-service
                      mcp:
                        host: http://${ECOMMERCE_MCP_HOST}:8003/mcp
                    - name: inventory-service
                      mcp:
                        host: http://${ECOMMERCE_MCP_HOST}:8004/mcp
                    - name: supplier-service
                      mcp:
                        host: http://${ECOMMERCE_MCP_HOST}:8005/mcp
